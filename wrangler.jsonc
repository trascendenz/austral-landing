{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "austral-collective",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-23",
	"assets": {
		"html_handling": "drop-trailing-slash",
		"run_worker_first": [
			"/api/*",
			"/r/*"
		]
	},
	"d1_databases": [
		{
			"binding": "austral_tracking",
			"database_name": "austral-tracking",
			"database_id": "0898016c-47d2-4525-83ff-1a98bb06f5a0",
			"remote": true
		}
	],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "REDIRECT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}